{
  "name": "client-app",
  "version": "0.0.0",
  "private": true,
  "description": "Logging framework and viewer",
  "repository": "https://github.com/discourse/logster/",
  "license": "MIT",
  "author": "Sam Saffron",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "vite build",
    "lint": "pnpm run lint:hbs && pnpm run lint:js",
    "lint:fix": "pnpm run lint:hbs:fix && pnpm run lint:js:fix",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "vite",
    "test": "pnpm run lint && pnpm run test:ember",
    "test:ember": "vite build --mode development && ember test --path dist"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/runtime": "^7.29.7",
    "@ember/optional-features": "^3.0.0",
    "@ember/string": "^4.0.1",
    "@ember/test-helpers": "^5.4.1",
    "@embroider/compat": "^4.1.17",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.4.7",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/vite": "^1.7.2",
    "@fortawesome/ember-fontawesome": "^3.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "@rollup/plugin-babel": "^7.0.0",
    "babel-plugin-ember-template-compilation": "^3.1.0",
    "decorator-transforms": "^2.3.1",
    "ember-cli": "~7.2.0",
    "ember-cli-babel": "^8.3.1",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.0.4",
    "ember-resolver": "^13.2.0",
    "ember-sinon-qunit": "^7.5.0",
    "ember-source": "~7.2.0",
    "ember-template-imports": "^4.4.0",
    "ember-template-lint": "^7.9.3",
    "ember-template-lint-plugin-discourse": "^3.0.0",
    "eslint": "^8.57.1",
    "eslint-config-discourse": "^5.1.0",
    "qunit": "^2.25.0",
    "qunit-dom": "^3.5.0",
    "sinon": "^22.0.0",
    "testem": "^3.20.1",
    "vite": "^8.0.10"
  },
  "engines": {
    "node": ">= 24 < 25"
  },
  "packageManager": "pnpm@10.28.0",
  "ember": {
    "edition": "octane"
  },
  "dependencies": {
    "moment": "^2.30.1"
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  }
}
